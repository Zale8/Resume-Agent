# ===== 操作系统 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== 编辑器 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 临时文件 =====
~$*
*.tmp
*.bak

# 岗位定制简历的临时生成脚本（未定稿保留迭代，定稿后删除，不入库）
/scripts/gen_*.py

# ===== Visual QA 临时工作区（Phase 3C，不入库）=====
/temp/

# ===== 个人简历数据（严禁入库）=====
# 数据目录已物理隔离在仓库外（../简历库/），以下规则为双保险
/data/
/jd/
/analysis/
/generated/
/config/

# 个人照片与证件照（任何位置）
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
# 例外：文档与测试所需图片
!docs/**/*.png
!tests/fixtures/**/*.jpg
!tests/fixtures/**/*.png

# 个人简历导出物（产品不内置任何 docx 模板，全部 docx 均视为个人产物）
*.pdf
*.docx

# ===== 依赖与构建 =====
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/

# ===== 渲染产物（默认落在仓库外，此处为兜底）=====
# 未指定简历库时的降级输出目录
_output/
# 渲染时自动产出的字段快照（可能含个人数据）
*.fields.json
