# ===== 操作系统 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== 编辑器 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 临时文件 =====
~$*
*.tmp
*.bak

# ===== 个人简历数据（严禁入库）=====
# 数据目录已物理隔离在仓库外（../简历库/），以下规则为双保险
/data/
/jd/
/analysis/
/generated/
/config/

# 个人照片与证件照（任何位置）
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
# 例外：模板/文档所需设计资源若未来需要入库，用 ! 取反
!templates/**/*.png
!docs/**/*.png

# 个人简历导出物
*.pdf
*.docx
# 例外：templates/ 下的空白模板 docx（含 {{FIELD}} 标记，无个人数据）
!templates/**/*.docx

# ===== 依赖与构建 =====
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/

# ===== 渲染产物（默认落在仓库外，此处为兜底）=====
# 未指定简历库时的降级输出目录
_output/
# 渲染时自动产出的字段快照（可能含个人数据）
*.fields.json
